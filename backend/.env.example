PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-secret-before-deploy
CORS_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_MS=6000
DATA_STORE=json
JSON_DB_PATH=data/db.json
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# To use MongoDB Atlas or a local MongoDB server:
# DATA_STORE=mongodb
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# MONGODB_DATABASE=gesture_control
# Optional comma-separated host allowlist, for example:
# ALLOWED_TARGET_HOSTS=192.168.1.10,homeassistant.local

